{
  "name": "remotion-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion project with three video template categories, a shared motion/design library, and deterministic adapters for GSAP, Anime.js and Lottie.",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "voiceover": "node --strip-types scripts/generate-voiceover.ts"
  },
  "dependencies": {
    "@remotion/captions": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/layout-utils": "^4.0.0",
    "@remotion/lottie": "^4.0.0",
    "@remotion/media": "^4.0.0",
    "@remotion/media-parser": "^4.0.508",
    "@remotion/media-utils": "^4.0.508",
    "@remotion/noise": "^4.0.0",
    "@remotion/paths": "^4.0.0",
    "@remotion/shapes": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "@remotion/zod-types": "^4.0.0",
    "animejs": "^4.0.2",
    "gsap": "^3.13.0",
    "lottie-web": "^5.12.2",
    "motion": "^13.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "zod": "^3.22.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
